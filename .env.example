# ─────────────────────────────────────────────────────────────────────────────
# code-documentation-assistant — configuration
#
# Topology is a CONFIG decision, not an architecture one. APP_MODE selects a
# preset of adapters; any individual line below overrides that preset.
# ─────────────────────────────────────────────────────────────────────────────

# embedded  = zero infrastructure. LanceDB + MiniSearch + Transformers.js in-process.
#             `npm run dev` and nothing else. This is the default the grader runs.
# distributed = service-backed. Qdrant + Ollama over the network (docker compose).
APP_MODE=embedded

# ── Per-component overrides (leave unset to take the APP_MODE preset) ─────────

# EMBED_PROVIDER=transformers-js         # transformers-js | tei | ollama
# EMBED_MODEL=Xenova/bge-base-en-v1.5    # or Xenova/jina-embeddings-v2-base-code

# VECTOR_STORE=lancedb                   # lancedb (embedded) | qdrant (service)
# QDRANT_URL=http://localhost:6333

# LEXICAL_INDEX=minisearch

# RERANK_PROVIDER=transformers-js        # transformers-js | tei
# RERANK_MODEL=Xenova/bge-reranker-base

# ── LLM: one OpenAI-compatible adapter reaches Ollama / Groq / vLLM / Together ─
# Only LLM_BASE_URL + LLM_MODEL change when you move from local to a hosted GPU.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:3b
# LLM_API_KEY=                           # blank for Ollama; set for hosted providers

# ── Queue: in-process (embedded) or bullmq+redis (distributed) ────────────────
# QUEUE_DRIVER=in-process
# REDIS_URL=redis://localhost:6379

# ── Tracing: jsonl files (embedded) or langfuse (distributed) ─────────────────
# TRACE_EXPORTER=jsonl                   # jsonl | langfuse
# LANGFUSE_URL=http://localhost:3000

# ── Retrieval knobs ───────────────────────────────────────────────────────────
# RETRIEVE_TOP_K=50                      # candidates fetched before rerank
# RERANK_TOP_K=8                         # survivors sent to the LLM
# MAX_HOPS=3                             # grade-loop ceiling (LangGraph recursion guard)

# ── Server ────────────────────────────────────────────────────────────────────
# API_PORT=8080
# WEB_PORT=5173
